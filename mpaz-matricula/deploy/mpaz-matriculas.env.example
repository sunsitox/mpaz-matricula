ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5100
AllowedHosts=matriculas.example.cl
DataProtection__KeysPath=/var/lib/mpaz-matriculas/keys
Seguridad__ExigirInicioSesion=true
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=mpaz_matricula;Username=mpaz_app;Password=REEMPLAZAR_CON_CLAVE_ALEATORIA;SSL Mode=Disable;Search Path=mpaz_matricula,public

# Expediente documental FUERA del release: /opt/mpaz-matriculas/current cambia
# en cada despliegue y los archivos subidos se perderían.
Documentos__RutaBase=/srv/mpaz-data/matriculas/documentos

# MAT-05 (medicación) queda apagado hasta aprobar el protocolo TENS.
Medicacion__Habilitada=false

# Login único: sin certificado de firma el emisor no se activa y el portal
# arranca igual. Al habilitarlo, configure Sso:CertificadoPfx y su clave.
# Sso__Habilitado=false

# Agregar temporalmente sólo durante el primer arranque si ya existen
# funcionarios sin cuenta Identity. Retirar después de crear/verificar cuentas.
# Seguridad__ContrasenaInicial=REEMPLAZAR_CON_CLAVE_INICIAL_TEMPORAL
