ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5100
AllowedHosts=matriculas.example.cl
DataProtection__KeysPath=/var/lib/mpaz-matriculas/keys
Seguridad__ExigirInicioSesion=true
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=mpaz_matricula;Username=mpaz_app;Password=REEMPLAZAR_CON_CLAVE_ALEATORIA;SSL Mode=Disable

# Agregar temporalmente sólo durante el primer arranque si ya existen
# funcionarios sin cuenta Identity. Retirar después de crear/verificar cuentas.
# Seguridad__ContrasenaInicial=REEMPLAZAR_CON_CLAVE_INICIAL_TEMPORAL
