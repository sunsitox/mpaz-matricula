# Entrega final · Portal de Matrícula MPAZ
# Copiar a .env y ajustar. Estas claves son de EJEMPLO: rótelas antes de operar
# con datos reales de estudiantes. La aplicación rechaza en Production las
# claves conocidas de ejemplo, así que no sirven tal cual.

# Contraseña del superusuario de PostgreSQL (solo administración interna).
CLAVE_POSTGRES=k7Qm2Lp9Vt4xRb8

# Contraseña del rol de la aplicación. La usa db-init/00-rol-app.sh al crear el
# rol en el primer arranque y la conexión de la app. Si cambia después, el rol
# conserva la anterior: actualícela con ALTER ROLE o recree el volumen.
CLAVE_APP=j4Wn8Tz3Hc6Yd2

# Contraseña inicial de las cuentas de funcionarios que se crean solas. Se
# retira del .env después del primer arranque.
CLAVE_INICIAL=Xk7Qm2Lp9Vt4

# Puerto publicado en el servidor (loopback). 5101 evita chocar con el preview.
PUERTO_APP=5101

# Dominio público del portal. Producción NO arranca con "*": debe ser el nombre
# exacto por el que se accede (Cloudflare Tunnel o DNS directo).
ALLOWED_HOSTS=matricula.empaz.cl
