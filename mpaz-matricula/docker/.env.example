# Entrega final · Portal de Matrícula MPAZ
# Copiar a .env y ajustar. Estas claves son de PRUEBA: deben rotarse antes de
# operar con datos reales de estudiantes.

# Contraseña del superusuario de PostgreSQL (solo administración interna).
CLAVE_POSTGRES=postgres_mpaz_2027

# Contraseña del rol de la aplicación. Debe coincidir con db-init/00-rol-app.sql.
CLAVE_APP=mpaz_app_2027

# Contraseña inicial de las cuentas de funcionarios que se crean solas.
CLAVE_INICIAL=Mpaz2027segura

# Puerto publicado en el servidor (loopback). 5101 evita chocar con el preview.
PUERTO_APP=5101

# Dominio público cuando se publique por Cloudflare Tunnel.
ALLOWED_HOSTS=*
