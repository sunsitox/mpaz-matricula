@model MarcelaPaz.Web.Models.FichaForm
@{
    Layout = "_WizardLayout";
}
<h2 class="wizard__titulo-paso">Paso 3 · Apoderado principal y secundario</h2>
<p class="wizard__ayuda">Por ahora puede avanzar sin completar los datos de los apoderados.</p>

<form asp-controller="Ficha" asp-action="Guardar" asp-route-id="3" method="post">

    <partial name="_ResumenValidacion" />
    <details class="wizard__desplegable" open>
        <summary class="wizard__desplegable-resumen">
            Apoderado principal
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Principal_Nombre_Apellido" class="acceso__etiqueta">Nombre / Apellido</label>
                    <input asp-for="Principal_Nombre_Apellido" class="acceso__input" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Principal_Cedula_Identidad" class="acceso__etiqueta">Cédula de identidad</label>
                    <input asp-for="Principal_Cedula_Identidad" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                    <span asp-validation-for="Principal_Cedula_Identidad" class="acceso__error"></span>
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Principal_Telefono" class="acceso__etiqueta">Teléfono</label>
                    <input asp-for="Principal_Telefono" type="tel" class="acceso__input" placeholder="Ej: +56 9 6123 4567" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Principal_Vinculo" class="acceso__etiqueta">Vínculo con el estudiante</label>
                    <input asp-for="Principal_Vinculo" class="acceso__input" autocomplete="off" />
                </div>
            </div>
            <div class="acceso__campo">
                <label asp-for="Principal_Correo" class="acceso__etiqueta">Correo electrónico</label>
                <input asp-for="Principal_Correo" type="email" class="acceso__input" autocomplete="off" />
                <span asp-validation-for="Principal_Correo" class="acceso__error"></span>
            </div>
        </div>
    </details>

    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Apoderado secundario
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Secundario_Nombre_Apellido" class="acceso__etiqueta">Nombre / Apellido</label>
                    <input asp-for="Secundario_Nombre_Apellido" class="acceso__input" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Secundario_Cedula_Identidad" class="acceso__etiqueta">Cédula de identidad</label>
                    <input asp-for="Secundario_Cedula_Identidad" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                    <span asp-validation-for="Secundario_Cedula_Identidad" class="acceso__error"></span>
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Secundario_Telefono" class="acceso__etiqueta">Teléfono</label>
                    <input asp-for="Secundario_Telefono" type="tel" class="acceso__input" placeholder="Ej: +56 9 6123 4567" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Secundario_Vinculo" class="acceso__etiqueta">Vínculo con el estudiante</label>
                    <input asp-for="Secundario_Vinculo" class="acceso__input" autocomplete="off" />
                </div>
            </div>
            <div class="acceso__campo">
                <label asp-for="Secundario_Correo" class="acceso__etiqueta">Correo electrónico</label>
                <input asp-for="Secundario_Correo" type="email" class="acceso__input" autocomplete="off" />
                <span asp-validation-for="Secundario_Correo" class="acceso__error"></span>
            </div>
        </div>
    </details>

    <div class="wizard__botones">
        <a class="acceso__boton-secundario" asp-controller="Ficha" asp-action="Paso" asp-route-id="2">Volver</a>
        <button type="submit" class="acceso__boton wizard__guardar">Guardar y continuar</button>
    </div>
</form>
