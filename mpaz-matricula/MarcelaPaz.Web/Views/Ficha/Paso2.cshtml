@model MarcelaPaz.Web.Models.FichaForm
@{
    Layout = "_WizardLayout";
}
<h2 class="wizard__titulo-paso">Paso 2 · Datos de contacto: madre y padre</h2>
<p class="wizard__ayuda">
    Madre y padre son dos bloques aparte, desplegables.
    Por ahora puede avanzar sin completar nada; los campos obligatorios se definirán con el colegio.
</p>

<form asp-controller="Ficha" asp-action="Guardar" asp-route-id="2" method="post">

    <partial name="_ResumenValidacion" />

    <!-- Bloque desplegable: datos de la madre -->
    <details class="wizard__desplegable" open>
        <summary class="wizard__desplegable-resumen">
            Datos de la madre
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Madre_Nombre_Apellido" class="acceso__etiqueta">Nombre / Apellido</label>
                    <input asp-for="Madre_Nombre_Apellido" class="acceso__input" placeholder="Ej: María Pérez Soto" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Madre_Cedula_Identidad" class="acceso__etiqueta">Cédula de identidad</label>
                    <input asp-for="Madre_Cedula_Identidad" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                    <span asp-validation-for="Madre_Cedula_Identidad" class="acceso__error"></span>
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Madre_Telefono" class="acceso__etiqueta">Teléfono</label>
                    <input asp-for="Madre_Telefono" class="acceso__input" placeholder="Ej: +56 9 6123 4567" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Madre_Escolaridad" class="acceso__etiqueta">Escolaridad</label>
                    <select asp-for="Madre_Escolaridad" class="acceso__input">
                        <option value="">— Seleccione —</option>
                        <option>Sin estudios</option>
                        <option>Educación básica</option>
                        <option>Educación media</option>
                        <option>Educación media técnico-profesional</option>
                        <option>Técnico de nivel superior</option>
                        <option>Educación universitaria</option>
                        <option>Postgrado</option>
                    </select>
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Madre_Domicilio" class="acceso__etiqueta">Domicilio</label>
                    <input asp-for="Madre_Domicilio" class="acceso__input" placeholder="Ej: Los Aromos 1234, Villa Los Aromos" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Madre_Correo" class="acceso__etiqueta">Correo electrónico</label>
                    <input asp-for="Madre_Correo" type="email" class="acceso__input" placeholder="Ej: madre@email.cl" autocomplete="off" />
                    <span asp-validation-for="Madre_Correo" class="acceso__error"></span>
                </div>
            </div>
        </div>
    </details>

    <!-- Bloque desplegable: datos del padre -->
    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Datos del padre
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Padre_Nombre_Apellido" class="acceso__etiqueta">Nombre / Apellido</label>
                    <input asp-for="Padre_Nombre_Apellido" class="acceso__input" placeholder="Ej: Juan Pérez Soto" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Padre_Cedula_Identidad" class="acceso__etiqueta">Cédula de identidad</label>
                    <input asp-for="Padre_Cedula_Identidad" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                    <span asp-validation-for="Padre_Cedula_Identidad" class="acceso__error"></span>
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Padre_Telefono" class="acceso__etiqueta">Teléfono</label>
                    <input asp-for="Padre_Telefono" class="acceso__input" placeholder="Ej: +56 9 6123 4567" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Padre_Escolaridad" class="acceso__etiqueta">Escolaridad</label>
                    <select asp-for="Padre_Escolaridad" class="acceso__input">
                        <option value="">— Seleccione —</option>
                        <option>Sin estudios</option>
                        <option>Educación básica</option>
                        <option>Educación media</option>
                        <option>Educación media técnico-profesional</option>
                        <option>Técnico de nivel superior</option>
                        <option>Educación universitaria</option>
                        <option>Postgrado</option>
                    </select>
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Padre_Domicilio" class="acceso__etiqueta">Domicilio</label>
                    <input asp-for="Padre_Domicilio" class="acceso__input" placeholder="Ej: Los Aromos 1234, Villa Los Aromos" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Padre_Correo" class="acceso__etiqueta">Correo electrónico</label>
                    <input asp-for="Padre_Correo" type="email" class="acceso__input" placeholder="Ej: padre@email.cl" autocomplete="off" />
                    <span asp-validation-for="Padre_Correo" class="acceso__error"></span>
                </div>
            </div>
        </div>
    </details>

    <!-- Restricción (SI/NO): la pregunta se aplica a la madre, tal como está en la ficha -->
    <fieldset class="wizard__restriccion">
        <legend class="acceso__etiqueta">Restricción (SI/NO)</legend>
        <p class="wizard__restriccion-pregunta">
            ¿Existe alguna restricción judicial o familiar que prohíba a la madre
            vincularse con el o la estudiante?
        </p>
        <div class="wizard__radios">
            <label class="acceso__radio">
                <input asp-for="Restriccion_Madre" type="radio" value="Si" />
                <span>Si</span>
            </label>
            <label class="acceso__radio">
                <input asp-for="Restriccion_Madre" type="radio" value="No" />
                <span>No</span>
            </label>
        </div>
        <span asp-validation-for="Restriccion_Madre" class="acceso__error"></span>
        <div class="acceso__campo">
            <span class="acceso__etiqueta">Tipo de restricción (sólo si respondió Sí)</span>
            <div class="wizard__radios">
                <label class="acceso__radio">
                    <input asp-for="Restriccion_Madre_Tipo" type="radio" value="Judicial" />
                    <span>Judicial</span>
                </label>
                <label class="acceso__radio">
                    <input asp-for="Restriccion_Madre_Tipo" type="radio" value="Familiar" />
                    <span>Familiar</span>
                </label>
            </div>
            <span asp-validation-for="Restriccion_Madre_Tipo" class="acceso__error"></span>
        </div>
        <div class="acceso__campo">
            <label asp-for="Restriccion_Madre_Detalle" class="acceso__etiqueta">Detalle de la restricción (sólo si respondió Sí)</label>
            <textarea asp-for="Restriccion_Madre_Detalle" class="acceso__input" rows="3" maxlength="500"
                      placeholder="Ej: orden del tribunal que prohíbe el acercamiento"></textarea>
            <span asp-validation-for="Restriccion_Madre_Detalle" class="acceso__error"></span>
        </div>
    </fieldset>

    <div class="wizard__botones">
        <a class="acceso__boton-secundario" asp-controller="Ficha" asp-action="Paso" asp-route-id="1">Volver</a>
        <button type="submit" class="acceso__boton wizard__guardar">Guardar y continuar</button>
    </div>
</form>
