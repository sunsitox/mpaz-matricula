@model MarcelaPaz.Web.Models.FichaForm
@{
    Layout = "_WizardLayout";
}
<h2 class="wizard__titulo-paso">Paso 1 · Datos del apoderado</h2>
<p class="wizard__ayuda">
    Primero el curso al que postula, luego la identificación y el domicilio.
    Los campos marcados con * son obligatorios. El estudiante puede identificarse con RUN o con IPE/IPA.
</p>

<form asp-controller="Ficha" asp-action="Guardar" asp-route-id="1" method="post">

    <partial name="_ResumenValidacion" />

    <details class="wizard__desplegable" open>
        <summary class="wizard__desplegable-resumen">
            Curso y año
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Curso_Nivel" class="acceso__etiqueta">Curso *</label>
                    <select asp-for="Curso_Nivel" class="acceso__input">
                        <option value="">— Seleccione —</option>
                        <option>NT1</option>
                        <option>NT2</option>
                        <option>1º básico</option>
                        <option>2º básico</option>
                        <option>3º básico</option>
                        <option>4º básico</option>
                        <option>5º básico</option>
                        <option>6º básico</option>
                        <option>7º básico</option>
                        <option>8º básico</option>
                    </select>
                    <span asp-validation-for="Curso_Nivel" class="acceso__error"></span>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Curso_Letra" class="acceso__etiqueta">Letra *</label>
                    <select asp-for="Curso_Letra" class="acceso__input">
                        <option value="">— Seleccione —</option>
                        <option>A</option>
                        <option>B</option>
                        <option>C</option>
                        <option>D</option>
                    </select>
                    <span asp-validation-for="Curso_Letra" class="acceso__error"></span>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Curso_Anio" class="acceso__etiqueta">Año escolar</label>
                    <input asp-for="Curso_Anio" class="acceso__input" readonly />
                </div>
            </div>
        </div>
    </details>

    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Identificación del apoderado
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Nombres" class="acceso__etiqueta">Nombres *</label>
                    <input asp-for="Nombres" class="acceso__input" placeholder="Ej: María" autocomplete="off" aria-required="true" />
                    <span asp-validation-for="Nombres" class="acceso__error"></span>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Apellido_Paterno" class="acceso__etiqueta">Apellido Paterno *</label>
                    <input asp-for="Apellido_Paterno" class="acceso__input" placeholder="Ej: Pérez" autocomplete="off" aria-required="true" />
                    <span asp-validation-for="Apellido_Paterno" class="acceso__error"></span>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Apellido_Materno" class="acceso__etiqueta">Apellido Materno</label>
                    <input asp-for="Apellido_Materno" class="acceso__input" placeholder="Ej: Soto" autocomplete="off" />
                    <span asp-validation-for="Apellido_Materno" class="acceso__error"></span>
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Tipo_Identificador" class="acceso__etiqueta">Tipo de documento *</label>
                    <select asp-for="Tipo_Identificador" class="acceso__input" aria-required="true">
                        <option value="RUN">RUN (cédula nacional)</option>
                        <option value="IPE">IPE (identificación provisoria)</option>
                        <option value="IPA">IPA (identificación provisoria)</option>
                    </select>
                    <span asp-validation-for="Tipo_Identificador" class="acceso__error"></span>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Cedula_Identidad" class="acceso__etiqueta">RUN o número IPE/IPA *</label>
                    <input asp-for="Cedula_Identidad" class="acceso__input" placeholder="Ej: 12.345.678-9 o IPE-1234" autocomplete="off" aria-required="true" />
                    <span asp-validation-for="Cedula_Identidad" class="acceso__error"></span>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Fecha_Nacimiento" class="acceso__etiqueta">Fecha nacimiento *</label>
                    <input asp-for="Fecha_Nacimiento" type="date" class="acceso__input" autocomplete="off" aria-required="true" />
                    <span asp-validation-for="Fecha_Nacimiento" class="acceso__error"></span>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Nacionalidad" class="acceso__etiqueta">Nacionalidad *</label>
                    <input asp-for="Nacionalidad" class="acceso__input" placeholder="Ej: Chilena" autocomplete="off" aria-required="true" />
                    <span asp-validation-for="Nacionalidad" class="acceso__error"></span>
                </div>
            </div>
        </div>
    </details>

    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Domicilio
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="acceso__campo">
                <label asp-for="Domicilio" class="acceso__etiqueta">Domicilio (calle – nº – villa o población) *</label>
                <input asp-for="Domicilio" class="acceso__input" placeholder="Ej: Los Aromos 1234, Villa Los Aromos" autocomplete="off" aria-required="true" />
                <span asp-validation-for="Domicilio" class="acceso__error"></span>
            </div>
            <div class="acceso__campo">
                <label asp-for="Comuna" class="acceso__etiqueta">Comuna *</label>
                <input asp-for="Comuna" class="acceso__input" placeholder="Ej: San Bernardo" autocomplete="off" aria-required="true" />
                <span asp-validation-for="Comuna" class="acceso__error"></span>
            </div>
        </div>
    </details>

    <div class="wizard__botones">
        <button type="submit" class="acceso__boton wizard__guardar">Guardar y continuar</button>
    </div>
</form>
