@model MarcelaPaz.Web.Models.FichaForm
@{
    Layout = "_WizardLayout";
}
<h2 class="wizard__titulo-paso">Paso 7 · Autorizaciones del apoderado</h2>
<p class="wizard__ayuda">
    Cada autorización se responde por separado y queda registrada con su fecha. El apoderado puede
    revocarlas por escrito en cualquier momento desde la ficha del estudiante.
</p>

<form asp-controller="Ficha" asp-action="Guardar" asp-route-id="7" method="post">

    <partial name="_ResumenValidacion" />

    <fieldset class="wizard__restriccion">
        <legend class="acceso__etiqueta">Autorización de uso de imagen</legend>
        <p class="wizard__restriccion-pregunta">
            Autorizo el registro y uso de imágenes de mi hijo/a con fines institucionales (captación interna,
            sitio web y redes sociales del establecimiento), sin exponer datos sensibles. Puedo revocar esta
            autorización por escrito en cualquier momento.
        </p>
        <div class="wizard__radios">
            <label class="acceso__radio">
                <input asp-for="AutorizaImagen" type="radio" value="Si" />
                <span>Si</span>
            </label>
            <label class="acceso__radio">
                <input asp-for="AutorizaImagen" type="radio" value="No" />
                <span>No</span>
            </label>
        </div>
        <span asp-validation-for="AutorizaImagen" class="acceso__error"></span>
    </fieldset>

    <fieldset class="wizard__restriccion">
        <legend class="acceso__etiqueta">Autorización para el trabajo con Convivencia Escolar</legend>
        <p class="wizard__restriccion-pregunta">
            Autorizo que el equipo de Convivencia Escolar acompañe e intervenga con mi hijo/a cuando sea
            necesario, con comunicación previa a la familia y posibilidad de revocar esta autorización por escrito.
        </p>
        <div class="wizard__radios">
            <label class="acceso__radio">
                <input asp-for="AutorizaConvivencia" type="radio" value="Si" />
                <span>Si</span>
            </label>
            <label class="acceso__radio">
                <input asp-for="AutorizaConvivencia" type="radio" value="No" />
                <span>No</span>
            </label>
        </div>
        <span asp-validation-for="AutorizaConvivencia" class="acceso__error"></span>
    </fieldset>

    <div class="wizard__botones">
        <a class="acceso__boton-secundario" asp-controller="Ficha" asp-action="Paso" asp-route-id="6">Volver</a>
        <button type="submit" class="acceso__boton wizard__guardar">Guardar y continuar</button>
    </div>
</form>
