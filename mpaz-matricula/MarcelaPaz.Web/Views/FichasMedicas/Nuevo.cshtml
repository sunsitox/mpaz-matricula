@model MarcelaPaz.Domain.Entidades.FichaSaludFuncionario
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nueva ficha de salud del personal";
    var funcionarios = ViewData["Funcionarios"] as List<MarcelaPaz.Web.Models.FichasMedicasPersonal.FuncionarioOpcion>
        ?? new List<MarcelaPaz.Web.Models.FichasMedicasPersonal.FuncionarioOpcion>();
}

<div class="admin__tarjeta">
    <h1 class="admin__titulo-seccion">Nueva ficha de salud</h1>
    <p class="admin__ayuda">
        Complete la ficha con los datos del funcionario. El documento se genera desde el sistema, listo para
        imprimir o descargar; no hay que subir archivos. La ficha queda en la sección Personal, visible sólo
        para UTP y Dirección.
    </p>

    @if (funcionarios.Count == 0)
    {
        <p class="admin__ayuda">No hay funcionarios activos registrados.</p>
        <a asp-action="Index" class="admin__boton">Volver al listado</a>
    }
    else
    {
        <form method="post" asp-action="Crear" data-ux-envio="Guardando la ficha de salud…">
            @Html.AntiForgeryToken()

            <partial name="_Campos" model="Model" />

            <div class="admin__acciones">
                <button type="submit" class="admin__boton admin__boton--primario">Guardar ficha</button>
                <a asp-action="Index" class="admin__boton">Cancelar</a>
            </div>
        </form>
    }
</div>
