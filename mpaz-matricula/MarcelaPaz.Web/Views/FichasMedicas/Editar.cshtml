@model MarcelaPaz.Domain.Entidades.FichaSaludFuncionario
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar ficha de salud del personal";
}

<div class="admin__tarjeta">
    <h1 class="admin__titulo-seccion">Editar ficha de salud</h1>
    <p class="admin__ayuda">
        Actualice los datos de la ficha. Al guardar, el documento generado desde el sistema usa esta versión;
        la fecha de registro se actualiza y el cambio queda auditado.
    </p>

    <form method="post" asp-action="Editar" asp-route-id="@Model.Id" data-ux-envio="Guardando cambios…">
        @Html.AntiForgeryToken()

        <partial name="_Campos" model="Model" />

        <div class="admin__acciones">
            <button type="submit" class="admin__boton admin__boton--primario">Guardar cambios</button>
            <a asp-action="Ver" asp-route-id="@Model.Id" class="admin__boton">Ver ficha</a>
            <a asp-action="Index" class="admin__boton">Volver al listado</a>
        </div>
    </form>
</div>
