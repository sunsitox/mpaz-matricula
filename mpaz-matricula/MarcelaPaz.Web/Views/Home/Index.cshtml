@model MarcelaPaz.Web.Models.PanelInicio
@using System.Security.Claims
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Panel";

    var nombre = User.FindFirst("nombre_funcionario")?.Value ?? User.Identity?.Name ?? "sin sesión";
    var roles = User.FindAll(ClaimTypes.Role).Select(c => c.Value).OrderBy(r => r).ToList();

    // La interfaz deriva la visibilidad sólo de los permisos de la sesión: no
    // puede prometer una acción que el servidor vaya a denegar (S-01).
    var puedeMatricula = User.HasClaim("permiso", "GENERAL:CREAR");
    var puedeFuncionarios = User.HasClaim("permiso", "ADMIN:ADMINISTRAR");

    var anios = ViewData["Anios"] as IReadOnlyList<MarcelaPaz.Web.Servicios.AnioEscolarOpcion>
        ?? Array.Empty<MarcelaPaz.Web.Servicios.AnioEscolarOpcion>();
}

@if (Model.Error is not null)
{
    <div class="acceso__alerta" role="alert">@Model.Error</div>
}

<div class="admin__tarjeta">
    <div class="panel__encabezado">
        <div>
            <h1 class="admin__titulo-seccion">@(Model.Anio > 0 ? $"Panel de matrícula {Model.Anio}" : "Panel de matrícula")</h1>
            <p class="admin__ayuda">Hola, @nombre. Cifras del proceso de matrícula y de los pendientes del año.</p>
        </div>
        <div>
            @if (anios.Count > 0)
            {
                <form method="get" asp-controller="Home" asp-action="Index" class="panel__anio">
                    <label class="acceso__etiqueta" for="anio">Año escolar</label>
                    <select class="acceso__input" id="anio" name="anio">
                        @foreach (var opcion in anios)
                        {
                            <option value="@opcion.Anio" selected="@(opcion.Anio == Model.Anio ? "selected" : null)">@opcion.Anio</option>
                        }
                    </select>
                    <button type="submit" class="admin__boton">Ver</button>
                </form>
            }

            @if (roles.Count == 0)
            {
                <span class="admin__ayuda">Sin roles activos en esta sesión.</span>
            }
            @foreach (var rol in roles)
            {
                <span class="admin__chip">@rol</span>
            }
            <p class="panel__meta">
                @if (Model.ActualizadoEn is DateTimeOffset actualizado)
                {
                    <text>Actualizado el @actualizado.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</text>
                    @if (!string.IsNullOrWhiteSpace(Model.Responsable))
                    {
                        <text> · última modificación de @Model.Responsable</text>
                    }
                }
                else
                {
                    <text>Aún no hay expedientes registrados para @Model.Anio.</text>
                }
            </p>
        </div>
    </div>
</div>

<section class="panel__kpis" aria-label="Indicadores principales">
    <div class="panel__kpi panel__kpi--destacado">
        <span class="panel__etiqueta">Matrículas @Model.Anio</span>
        <strong class="panel__valor">@Model.TotalMatriculas</strong>
        <span class="panel__detalle">@Model.Renovaciones renovaciones · @Model.Nuevas nuevas</span>
    </div>

    <div class="panel__kpi">
        <span class="panel__etiqueta">Cerradas</span>
        <strong class="panel__valor">@Model.Cerradas</strong>
        <span class="panel__detalle">@Model.Avance% del total del año</span>
    </div>

    <div class="panel__kpi">
        <span class="panel__etiqueta">Por cerrar</span>
        <strong class="panel__valor">@Model.Borradores</strong>
        <span class="panel__detalle">expedientes en borrador</span>
    </div>

    <div class="panel__kpi panel__kpi--alerta">
        <span class="panel__etiqueta">Pendientes documentales</span>
        <strong class="panel__valor">@Model.PendientesDocumentales</strong>
        <span class="panel__detalle">documentos por entregar o validar</span>
    </div>
</section>

<div class="panel__columnas">
    <div class="admin__tarjeta">
        <h2 class="admin__titulo-seccion">Avance por curso</h2>

        @if (Model.Cursos.Count == 0)
        {
            <p class="admin__ayuda">Todavía no hay matrículas @Model.Anio registradas.</p>
        }
        else
        {
            <div class="tabla-envoltura" tabindex="0">
                <table class="admin__tabla">
                    <caption class="sr-only">Avance de matrícula por curso.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Curso</th>
                            <th scope="col">Total</th>
                            <th scope="col">Cerradas</th>
                            <th scope="col">Avance</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var curso in Model.Cursos)
                    {
                        <tr>
                            <td>@curso.Curso</td>
                            <td>@curso.Total</td>
                            <td>@curso.Cerradas</td>
                            <td>
                                <div class="panel__celda-avance">
                                    <div class="panel__barra">
                                        <span class="panel__barra-relleno" style="width:@(curso.Avance)%"></span>
                                    </div>
                                    <span class="panel__pct">@curso.Avance%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
    </div>

    <div class="admin__tarjeta">
        <h2 class="admin__titulo-seccion">Pendientes y respaldos</h2>
        <ul class="panel__lista">
            <li><span>Fichas con folio emitidas</span><strong>@Model.FichasConFolio</strong></li>
            <li><span>Autorizaciones vigentes</span><strong>@Model.AutorizacionesVigentes</strong></li>
            <li><span>Documentos y autorizaciones vencidas</span><strong>@Model.AlertasVencimiento</strong></li>
            <li><span>Estudiantes en el registro único</span><strong>@Model.EstudiantesRegistrados</strong></li>
            <li><span>Funcionarios activos</span><strong>@Model.FuncionariosActivos</strong></li>
        </ul>
    </div>
</div>

<div class="admin__tarjeta">
    <h2 class="admin__titulo-seccion">Últimos accesos</h2>

    @if (Model.Accesos.Count == 0)
    {
        <p class="admin__ayuda">Sin actividad registrada todavía.</p>
    }
    else
    {
        <div class="tabla-envoltura" tabindex="0">
            <table class="admin__tabla">
                <caption class="sr-only">Últimos accesos registrados en el portal.</caption>
                <thead>
                    <tr>
                        <th scope="col">Fecha</th>
                        <th scope="col">Acción</th>
                        <th scope="col">Área</th>
                        <th scope="col">Funcionario</th>
                    </tr>
                </thead>
            <tbody>
                @foreach (var acceso in Model.Accesos)
                {
                    <tr>
                        <td class="panel__fecha">@acceso.Cuando.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@acceso.Accion</td>
                        <td>@(acceso.Area ?? "—")</td>
                        <td>@(acceso.Funcionario ?? "—")</td>
                    </tr>
                }
            </tbody>
            </table>
            </div>
        }
</div>

<div class="admin__tarjeta">
    <h2 class="admin__titulo-seccion">Acciones</h2>
    <p class="admin__ayuda">Lo que puede hacer con su rol en este momento.</p>

    <div class="panel__acciones">
        @if (puedeMatricula)
        {
            <a class="admin__boton admin__boton--primario" asp-controller="Ficha" asp-action="Buscar">Buscar estudiante</a>
            <form method="post" asp-controller="Ficha" asp-action="Nueva" class="admin__accion-inline">
                <button type="submit" class="admin__boton">Matrícula nueva</button>
            </form>
        }

        @if (puedeFuncionarios)
        {
            <a class="admin__boton" asp-controller="Funcionarios" asp-action="Index">Administrar funcionarios</a>
        }
    </div>
</div>
