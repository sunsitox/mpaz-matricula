@{
    Layout = null;
    ViewData["Title"] = "Error";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error · Portal Marcela Paz</title>
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/acceso.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ux.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/formulario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/envio.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/logo-mpaz-simplificado.ico" />
</head>
<body class="error">
    <main class="error__card">
        <img src="~/images/logo-mpaz.svg"
             alt="Logo Escuela Escritora Marcela Paz"
             class="acceso__logo-img"                 width="48" />
        <p class="admin__ayuda">Portal Marcela Paz</p>
        <h1>Ocurrió un problema</h1>
        <p>No pudimos completar la operación. Intente nuevamente.</p>
        <p>Si el problema continúa, avise a Administración TI.</p>
        <a class="acceso__enlace" asp-controller="Cuenta" asp-action="Login">Volver al inicio</a>
    </main>
</body>
</html>
