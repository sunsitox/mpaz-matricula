@inject MarcelaPaz.Web.Servicios.AnioEscolar AniosEscolares
@{
    var pasoActual = (int)(ViewData["Paso"] ?? 1);
    string[] nombresPasos = { "Estudiante", "Madre y padre", "Apoderados", "Emergencia", "Retiro", "Salud y PIE", "Autorizaciones", "Revisar y confirmar" };

    var anioActivo = await AniosEscolares.ActivoAsync();
    var tituloPagina = anioActivo is int anio
        ? $"Ficha de matrícula {anio}"
        : "Ficha de matrícula";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tituloPagina · Portal Marcela Paz</title>
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/acceso.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ux.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/formulario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/envio.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/logo-mpaz-simplificado.ico" />
</head>
<body class="wizard">

    <a class="saltar-contenido" href="#contenido-principal">Saltar al contenido de la ficha</a>

    <!-- Encabezado del wizard (mockup 02) -->
    <header class="wizard__header">
        <div class="wizard__marca">
            @* Logo oficial del colegio: emblema circular con borde dorado *@
            <img src="~/images/logo-mpaz.svg"
                 alt="Logo Escuela Escritora Marcela Paz"
                 class="wizard__logo"
                 width="56" height="56" />
            <div class="wizard__titulo">Portal Marcela Paz</div>
        </div>

        <div class="wizard__acciones">
            @if (anioActivo is int anioChip)
            {
                <span class="wizard__anio">Año escolar @anioChip</span>
            }
            <a class="wizard__salir" asp-controller="Home" asp-action="Index">Salir de la ficha</a>
        </div>

        @if (TempData["Aviso"] is string aviso)
        {
            <div class="wizard__aviso-header" role="status">@aviso</div>
        }
    </header>

    @if (ViewData["Modo"] is string modo)
    {
        <div class="wizard__modo" role="status">
            <strong>@modo</strong>
            @if (ViewData["ModoDetalle"] is string detalleModo)
            {
                <span class="wizard__modo-detalle">@detalleModo</span>
            }
        </div>
    }

    <!-- Stepper de progreso -->
    <nav class="wizard__pasos" aria-label="Pasos de la ficha">
        @for (var i = 1; i <= nombresPasos.Length; i++)
        {
            var clase = i < pasoActual ? "wizard__paso--hecho"
                      : i == pasoActual ? "wizard__paso--activo"
                      : "wizard__paso--pendiente";
            // El estado no puede depender sólo del color (WCAG 1.4.1).
            var estado = i < pasoActual ? "completado" : i == pasoActual ? "en curso" : "pendiente";
            <div class="wizard__paso @clase" @(i == pasoActual ? "aria-current=\"step\"" : "")>
                <span class="wizard__paso-numero" aria-hidden="true">@i</span>
                <span class="wizard__paso-texto">@nombresPasos[i - 1]</span>
                <span class="sr-only">Paso @i de 8: @estado</span>
            </div>
        }
    </nav>

    <main id="contenido-principal" tabindex="-1" class="wizard__cuerpo @(ViewData["AnchoAmplio"] is true ? "wizard__cuerpo--amplio" : null)">
        <div class="wizard__contexto @(ViewData["AnchoAmplio"] is true ? "wizard__contexto--amplio" : null)">
            <h1 class="wizard__titulo-pagina">@tituloPagina</h1>
            <p class="wizard__ayuda-pagina">Complete los ocho pasos; puede retomar la ficha más tarde.</p>
        </div>

        <div class="wizard__tarjeta">
            @RenderBody()
        </div>

        <div class="wizard__nota-guardado">
            Al presionar «Guardar y continuar», lo escrito queda guardado en la ficha del estudiante.
            <span class="wizard__nota-guardado-detalle">Puede retomarla después desde la ficha del alumno.</span>
        </div>
    </main>

    <partial name="_Notificacion" />

    <script src="~/js/ux.js" asp-append-version="true" defer></script>
</body>
</html>
