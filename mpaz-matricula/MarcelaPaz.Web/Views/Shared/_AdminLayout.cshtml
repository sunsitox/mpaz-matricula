@inject Microsoft.Extensions.Configuration.IConfiguration Configuracion
@{
    var nombre = User.FindFirst("nombre_funcionario")?.Value ?? User.Identity?.Name ?? "Modo revisión (sin login)";

    var exigirLogin = Configuracion.GetValue<bool>("Seguridad:ExigirInicioSesion");
    var puedeAlumnos = !exigirLogin || User.HasClaim("permiso", "GENERAL:LEER");
    var puedeMatricula = !exigirLogin || User.HasClaim("permiso", "GENERAL:CREAR");
    var puedeFuncionarios = !exigirLogin || User.HasClaim("permiso", "ADMIN:ADMINISTRAR");

    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();

    string Clase(string nombreControlador) =>
        string.Equals(controlador, nombreControlador, StringComparison.OrdinalIgnoreCase)
            ? "admin__menu-enlace admin__menu-enlace--activo"
            : "admin__menu-enlace";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Portal de Matrícula 2027</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-admin.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/logo-mpaz-simplificado.ico" />
</head>
<body class="admin">
    <header class="admin__header">
        <div class="admin__marca">
            <img src="~/images/logo-mpaz.svg"
                 alt="Logo Escuela Escritora Marcela Paz"
                 class="acceso__logo-img"
                 width="40" />
            <div>
                <div class="admin__titulo">Portal de Matrícula 2027</div>
                <div class="admin__subtitulo">@ViewData["Title"]</div>
            </div>
        </div>

        <div class="admin__sesion">
            <span class="admin__usuario">@nombre</span>
            <form asp-controller="Cuenta" asp-action="Salida" method="post">
                <button type="submit" class="admin__salir">Cerrar sesión</button>
            </form>
        </div>
    </header>

    <div class="admin__cuerpo">
        <nav class="admin__menu" aria-label="Secciones del portal">
            <p class="admin__menu-titulo">Menú</p>

            <a class="@Clase("Home")" asp-controller="Home" asp-action="Index">Panel</a>

            @if (puedeAlumnos)
            {
                <a class="@Clase("Alumnos")" asp-controller="Alumnos" asp-action="Index">Alumnos</a>
            }

            @if (puedeMatricula)
            {
                <a class="@Clase("Ficha")" asp-controller="Ficha" asp-action="Buscar">Matrícula</a>
            }

            @if (puedeFuncionarios)
            {
                <a class="@Clase("Funcionarios")" asp-controller="Funcionarios" asp-action="Index">Funcionarios</a>
            }
        </nav>

        <main class="admin__contenedor">
            @if (TempData["Aviso"] is string aviso)
            {
                <div class="acceso__info" role="status">@aviso</div>
            }
            @RenderBody()
        </main>
    </div>

    <partial name="_Notificacion" />

    <script src="~/js/ux.js" asp-append-version="true" defer></script>
</body>
</html>
