@model MarcelaPaz.Web.Models.FiltroAlumnos
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Estudiantes";

    Func<string, string> enlaceOrden = columna => Url.Action("Index", new
    {
        q = Model.Texto,
        anio = Model.Anio > 0 ? Model.Anio : (int?)null,
        curso = Model.Curso,
        estado = Model.Estado,
        pendientes = Model.SoloPendientes ? "true" : null,
        orden = columna,
        dir = Model.Orden == columna && Model.Direccion == "asc" ? "desc" : "asc",
        tamano = Model.TamanoPagina,
        pagina = 1,
    })!;

    Func<int, string> enlacePagina = numero => Url.Action("Index", new
    {
        q = Model.Texto,
        anio = Model.Anio > 0 ? Model.Anio : (int?)null,
        curso = Model.Curso,
        estado = Model.Estado,
        pendientes = Model.SoloPendientes ? "true" : null,
        orden = Model.Orden,
        dir = Model.Direccion,
        tamano = Model.TamanoPagina,
        pagina = numero,
    })!;

    // Ventana compacta de páginas: 1 … actual-1, actual, actual+1 … última.
    var paginas = new List<int?>();
    if (Model.TotalPaginas > 1)
    {
        var numeros = new SortedSet<int> { 1, Model.TotalPaginas }; 
        for (var n = Model.Pagina - 1; n <= Model.Pagina + 1; n++)
        {
            if (n >= 1 && n <= Model.TotalPaginas)
            {
                numeros.Add(n);
            }
        }
        var anterior = 0;
        foreach (var n in numeros)
        {
            if (anterior > 0 && n - anterior > 1)
            {
                paginas.Add(null);
            }
            paginas.Add(n);
            anterior = n;
        }
    }

    Func<string, string> flecha = columna =>
        Model.Orden != columna ? string.Empty : Model.Direccion == "desc" ? "▼" : "▲";

    Func<string, string> claseOrden = columna =>
        Model.Orden == columna ? "alumnos__orden alumnos__orden--activo" : "alumnos__orden";

    // aria-sort comunica la columna y el sentido del orden (WCAG 1.3.1 · ARIA APG).
    Func<string, string> ariaSort = columna =>
        Model.Orden != columna ? "none" : Model.Direccion == "desc" ? "descending" : "ascending";
}

<section class="admin__tarjeta">
    <div class="alumnos__encabezado">
        <div>
            <h1 class="admin__titulo-seccion">Estudiantes</h1>
            <p class="admin__ayuda">
                Busque por nombre, RUN, IPE o IPA; filtre por año, curso, estado o pendientes y ordene por cualquier columna.
            </p>
        </div>
        <div class="alumnos__acciones-cabecera">
            @if (Model.Anio > 0)
            {
                <span class="alumnos__insignia">Año escolar @Model.Anio</span>
            }
            <a class="admin__boton" asp-controller="Reportes" asp-action="Matriculas"
               asp-route-anio="@(Model.Anio > 0 ? Model.Anio : (int?)null)" data-ux-cargando>Reportes</a>
        </div>
    </div>

    <form method="get" asp-controller="Alumnos" asp-action="Index" class="alumnos__filtros">
        <div class="alumnos__filtros-campos">
        @if (Model.Anios.Count > 0)
        {
            <div class="acceso__campo">
                <label class="acceso__etiqueta" for="anio">Año escolar</label>
                <select class="acceso__input" id="anio" name="anio">
                    @foreach (var anio in Model.Anios)
                    {
                        <option value="@anio" selected="@(anio == Model.Anio ? "selected" : null)">@anio</option>
                    }
                </select>
            </div>
        }

        <div class="acceso__campo alumnos__campo-texto">
            <label class="acceso__etiqueta" for="q">Buscar</label>
            <input class="acceso__input" id="q" name="q" value="@Model.Texto"
                   placeholder="Nombre, RUN, IPE o IPA" autocomplete="off" />
        </div>

        <div class="acceso__campo">
            <label class="acceso__etiqueta" for="curso">Curso</label>
            <select class="acceso__input" id="curso" name="curso">
                <option value="">Todos</option>
                @foreach (var curso in Model.Cursos)
                {
                    <option value="@curso" selected="@(curso == Model.Curso ? "selected" : null)">@curso</option>
                }
            </select>
        </div>

        <div class="acceso__campo">
            <label class="acceso__etiqueta" for="estado">Estado</label>
            <select class="acceso__input" id="estado" name="estado">
                <option value="">Todos</option>
                @foreach (var estado in Model.Estados)
                {
                    <option value="@estado" selected="@(estado == Model.Estado ? "selected" : null)">@estado</option>
                }
            </select>
        </div>

        </div>

        <div class="alumnos__filtros-pie">
            <label class="alumnos__check">
                <input type="checkbox" name="pendientes" value="true"
                       checked="@(Model.SoloPendientes ? "checked" : null)" />
                <span>Solo con pendientes</span>
            </label>

            <button type="submit" class="admin__boton admin__boton--primario alumnos__boton-buscar">Filtrar</button>
        </div>
    </form>

    <p class="alumnos__filtros-ayuda">
        Presione Enter para buscar. El RUN se acepta con o sin puntos; el IPE y el IPA, tal como figuran en el registro.
    </p>
</section>

<section class="admin__tarjeta">
    <div class="alumnos__resumen">
        <p class="alumnos__conteo">
            @if (Model.TotalAlumnos == 0)
            {
                <strong>0 alumnos</strong>
            }
            else
            {
                <text>Mostrando <strong>@(Model.Desde)–@(Model.Hasta)</strong> de <strong>@Model.TotalAlumnos</strong> alumnos</text>
            }
            @if (Model.TieneFiltros)
            {
                <text>con los filtros aplicados</text>
            }
        </p>

        @if (Model.TotalPaginas > 1)
        {
            <form method="get" asp-controller="Alumnos" asp-action="Index" class="alumnos__tamano">
                <input type="hidden" name="q" value="@Model.Texto" />
                <input type="hidden" name="anio" value="@Model.Anio" />
                <input type="hidden" name="curso" value="@Model.Curso" />
                <input type="hidden" name="estado" value="@Model.Estado" />
                <input type="hidden" name="pendientes" value="@(Model.SoloPendientes ? "true" : null)" />
                <input type="hidden" name="orden" value="@Model.Orden" />
                <input type="hidden" name="dir" value="@Model.Direccion" />
                <label class="alumnos__tamano-etiqueta" for="tamano">Por página</label>
                <select class="acceso__input" id="tamano" name="tamano" data-ux-enviar-al-cambiar>
                    @foreach (var opcion in new[] { 25, 50, 100 })
                    {
                        <option value="@opcion" selected="@(opcion == Model.TamanoPagina ? "selected" : null)">@opcion</option>
                    }
                </select>
            </form>
        }

        @if (Model.TieneFiltros)
        {
            <a class="alumnos__limpiar" asp-controller="Alumnos" asp-action="Index"
               asp-route-anio="@Model.Anio">Limpiar filtros</a>
        }
    </div>

    @if (Model.Alumnos.Count == 0)
    {
        <div class="alumnos__vacio">
            <p class="alumnos__vacio-texto">No hay alumnos que coincidan con la búsqueda.</p>
            <a class="admin__boton" asp-controller="Alumnos" asp-action="Index" asp-route-anio="@Model.Anio">Ver todos los alumnos</a>
        </div>
    }
    else
    {
        <div class="alumnos__tabla-envoltura" tabindex="0">
            <table class="admin__tabla alumnos__tabla">
                <caption class="sr-only">
                    Estudiantes registrados en el año escolar @Model.Anio, con documento, curso, estado, tipo de matrícula,
                    comuna y pendientes. Cada encabezado ordena la tabla.
                </caption>
                <thead>
                    <tr>
                        <th scope="col" aria-sort="@ariaSort("nombre")">
                            <a class="@claseOrden("nombre")" href="@enlaceOrden("nombre")">
                                Alumno <span class="alumnos__flecha" aria-hidden="true">@flecha("nombre")</span>
                            </a>
                        </th>
                        <th scope="col" aria-sort="@ariaSort("rut")">
                            <a class="@claseOrden("rut")" href="@enlaceOrden("rut")">
                                Documento <span class="alumnos__flecha" aria-hidden="true">@flecha("rut")</span>
                            </a>
                        </th>
                        <th scope="col" aria-sort="@ariaSort("curso")">
                            <a class="@claseOrden("curso")" href="@enlaceOrden("curso")">
                                Curso @Model.Anio <span class="alumnos__flecha" aria-hidden="true">@flecha("curso")</span>
                            </a>
                        </th>
                        <th scope="col" aria-sort="@ariaSort("estado")">
                            <a class="@claseOrden("estado")" href="@enlaceOrden("estado")">
                                Estado <span class="alumnos__flecha" aria-hidden="true">@flecha("estado")</span>
                            </a>
                        </th>
                        <th scope="col" aria-sort="@ariaSort("tipo")">
                            <a class="@claseOrden("tipo")" href="@enlaceOrden("tipo")">
                                Matrícula <span class="alumnos__flecha" aria-hidden="true">@flecha("tipo")</span>
                            </a>
                        </th>
                        <th scope="col" aria-sort="@ariaSort("comuna")">
                            <a class="@claseOrden("comuna")" href="@enlaceOrden("comuna")">
                                Comuna <span class="alumnos__flecha" aria-hidden="true">@flecha("comuna")</span>
                            </a>
                        </th>
                        <th scope="col" aria-sort="@ariaSort("pendientes")">
                            <a class="@claseOrden("pendientes")" href="@enlaceOrden("pendientes")">
                                Pendientes <span class="alumnos__flecha" aria-hidden="true">@flecha("pendientes")</span>
                            </a>
                        </th>
                        <th scope="col" class="alumnos__col-accion">Ficha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alumno in Model.Alumnos)
                    {
                        <tr>
                            <td>
                                <a class="alumnos__nombre" asp-action="Detalle" asp-route-id="@alumno.Id"
                                   asp-route-anio="@Model.Anio">
                                    @alumno.Nombre
                                </a>
                            </td>
                            <td class="alumnos__dato">@alumno.Rut</td>
                            <td class="alumnos__dato">@(alumno.Curso ?? "—")</td>
                            <td>
                                <span class="alumnos__estado @alumno.EstadoClase">@alumno.EstadoTexto</span>
                            </td>
                            <td class="alumnos__dato">@alumno.TipoTexto</td>
                            <td class="alumnos__dato">@(alumno.Comuna ?? "—")</td>
                            <td>
                                @if (alumno.TienePendientes)
                                {
                                    <span class="alumnos__estado alumnos__estado--borrador">@alumno.PendientesTexto</span>
                                }
                                else
                                {
                                    <span class="alumnos__dato">—</span>
                                }
                            </td>
                            <td class="alumnos__col-accion">
                                <a class="alumnos__ver" asp-action="Detalle" asp-route-id="@alumno.Id"
                                   asp-route-anio="@Model.Anio">
                                    Ver ficha
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="alumnos__paginacion" aria-label="Paginación de estudiantes">
                <span class="alumnos__paginacion-info">Página @Model.Pagina de @Model.TotalPaginas</span>
                <ul class="alumnos__paginacion-lista">
                    <li>
                        @if (Model.HayAnterior)
                        {
                            <a class="alumnos__paginacion-enlace" href="@enlacePagina(Model.Pagina - 1)" rel="prev">‹ Anterior</a>
                        }
                        else
                        {
                            <span class="alumnos__paginacion-enlace alumnos__paginacion-enlace--apagado" aria-disabled="true">‹ Anterior</span>
                        }
                    </li>
                    @foreach (var numero in paginas)
                    {
                        if (numero is null)
                        {
                            <li><span class="alumnos__paginacion-enlace alumnos__paginacion-enlace--apagado" aria-hidden="true">…</span></li>
                        }
                        else if (numero.Value == Model.Pagina)
                        {
                            <li><span class="alumnos__paginacion-enlace alumnos__paginacion-enlace--actual" aria-current="page">@numero.Value</span></li>
                        }
                        else
                        {
                            <li><a class="alumnos__paginacion-enlace" href="@enlacePagina(numero.Value)">@numero.Value</a></li>
                        }
                    }
                    <li>
                        @if (Model.HaySiguiente)
                        {
                            <a class="alumnos__paginacion-enlace" href="@enlacePagina(Model.Pagina + 1)" rel="next">Siguiente ›</a>
                        }
                        else
                        {
                            <span class="alumnos__paginacion-enlace alumnos__paginacion-enlace--apagado" aria-disabled="true">Siguiente ›</span>
                        }
                    </li>
                </ul>
            </nav>
        }
    }
</section>
