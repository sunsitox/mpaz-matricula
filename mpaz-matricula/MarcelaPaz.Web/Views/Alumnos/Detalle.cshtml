@model MarcelaPaz.Web.Models.PerfilAlumno
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Estudiantes";

    var puedeMatricula = User.HasClaim("permiso", "GENERAL:CREAR");
}

<div class="perfil">
<div class="admin__tarjeta perfil__presentacion">
    <div class="perfil__cabecera">
        <div>
            <a class="alumnos__volver" asp-action="Index" asp-route-anio="@Model.Anio">← Volver al listado</a>
            <h1 class="admin__titulo-seccion">@Model.Nombre</h1>
            <p class="admin__ayuda">
                RUN @Model.Rut
                @if (Model.CursoActual is not null)
                {
                    <text> · @Model.CursoActual</text>
                }
                @if (Model.Edad is int edad)
                {
                    <text> · @edad años</text>
                }
            </p>
            <div>
                <span class="admin__chip">Año escolar @Model.Anio</span>
                <span class="admin__chip">@(Model.EstadoActual ?? $"Sin matrícula {Model.Anio}")</span>
                @if (Model.Restricciones.Count > 0)
                {
                    <span class="admin__chip admin__chip--alerta">Restricción vigente</span>
                }
            </div>
            @if (Model.ActualizadaEn is DateTimeOffset actualizada)
            {
                <p class="admin__ayuda">
                    Última actualización:
                    @actualizada.ToLocalTime().ToString("dd-MM-yyyy HH:mm")@if (Model.ActualizadaPor is string responsable)
                    {<text> · @responsable</text>}
                </p>
            }
        </div>

        <div class="alumnos__acciones">
            <a class="admin__boton admin__boton--primario"
               asp-controller="Ficha" asp-action="FormularioAlumno" asp-route-id="@Model.Id"
               asp-route-anio="@Model.Anio"
               data-ux-cargando>
                Descargar formulario
            </a>
            @if (puedeMatricula)
            {
                <a class="admin__boton"
                   asp-controller="Ficha" asp-action="Buscar" asp-route-rut="@Model.Rut">Abrir en matrícula</a>
            }
            @if (Model.PuedeRenovarAnio)
            {
                <form method="post" asp-controller="Ficha" asp-action="Renovar" asp-route-id="@Model.Id"
                      data-ux-envio="Abriendo la matrícula del año…">
                    <button type="submit" class="admin__boton admin__boton--primario">
                        Iniciar matrícula @Model.Anio
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@* Pestañas con acceso condicionado (sección 9 del requerimiento): cada pestaña
   muestra solo lo que el rol puede ver; sin el permiso, el panel explica la
   ausencia en vez de mostrar una lista vacía (S-02). Sin JS, todo queda visible. *@
<nav class="perfil__pestanas" aria-label="Secciones de la ficha" data-ux-pestanas>
    <div role="tablist" aria-label="Secciones de la ficha">
        <button type="button" role="tab" id="pestana-general" class="perfil__pestana"
                data-ux-pestana="general" aria-selected="true"
                aria-controls="panel-general-ficha panel-general-datos panel-general-apoderados panel-general-contactos">General</button>
        <button type="button" role="tab" id="pestana-autorizaciones" class="perfil__pestana"
                data-ux-pestana="autorizaciones" aria-selected="false" tabindex="-1"
                aria-controls="panel-autorizaciones">Autorizaciones</button>
        <button type="button" role="tab" id="pestana-documentos" class="perfil__pestana"
                data-ux-pestana="documentos" aria-selected="false" tabindex="-1"
                aria-controls="panel-documentos">Documentos</button>
        <button type="button" role="tab" id="pestana-salud" class="perfil__pestana"
                data-ux-pestana="salud" aria-selected="false" tabindex="-1"
                aria-controls="panel-salud">Salud</button>
        <button type="button" role="tab" id="pestana-pie" class="perfil__pestana"
                data-ux-pestana="pie" aria-selected="false" tabindex="-1"
                aria-controls="panel-pie">PIE</button>
    </div>
    <p class="admin__ayuda">Salud, PIE y documentos muestran solo lo que su rol puede ver.</p>
</nav>

<section class="admin__tarjeta" data-ux-grupo="general" role="tabpanel" id="panel-general-ficha"
         aria-labelledby="pestana-general" tabindex="0">
    <h2 class="admin__titulo-seccion">Ficha de matrícula</h2>

    @if (!string.IsNullOrWhiteSpace(Model.FolioFicha))
    {
        <div class="perfil__dato"><span>Folio</span><strong>@Model.FolioFicha</strong></div>
        <div class="perfil__dato"><span>Versión</span><strong>@Model.VersionFicha</strong></div>
    }
    else
    {
        <p class="admin__ayuda">Sin ficha generada para el año: se genera al finalizar el asistente de matrícula.</p>
    }

    @if (Model.PuedeCorregirFicha && Model.MatriculaId is int correccionMatriculaId)
    {
        <form method="post" asp-controller="Ficha" asp-action="Corregir"
              asp-route-matriculaId="@correccionMatriculaId" data-ux-envio="Abriendo la corrección…">
            <button type="submit" class="admin__boton">Corregir ficha (nueva versión)</button>
        </form>
        <p class="admin__ayuda">
            La corrección parte de la copia congelada de la ficha vigente y exige un motivo. Al cerrarla se crea
            una versión nueva: la anterior queda como reemplazada y no se modifica.
        </p>
    }

    @if (Model.Versiones.Count > 0)
    {
        <h3 class="admin__titulo-seccion">Versiones de la ficha</h3>
        <div class="tabla-envoltura" tabindex="0">
            <table class="admin__tabla">
                <caption class="sr-only">Versiones de la ficha de matrícula, con folio, estado y motivo de corrección.</caption>
                <thead>
                    <tr>
                        <th scope="col">Versión</th>
                        <th scope="col">Folio</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Generada</th>
                        <th scope="col">Motivo de la corrección</th>
                        <th scope="col">PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var version in Model.Versiones)
                    {
                        <tr>
                            <td>@version.Numero</td>
                            <td>@version.Folio</td>
                            <td>@(version.Estado == "VIGENTE" ? "Vigente" : "Reemplazada")</td>
                            <td>
                                @version.GeneradaEn.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(version.GeneradaPor))
                                {
                                    <span class="admin__ayuda"> · @version.GeneradaPor</span>
                                }
                            </td>
                            <td>@(version.MotivoCorreccion ?? "—")</td>
                            <td>
                                <a asp-controller="Ficha" asp-action="Version" asp-route-id="@version.Id">Descargar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</section>

<section class="admin__tarjeta" data-ux-grupo="autorizaciones" role="tabpanel" id="panel-autorizaciones"
         aria-labelledby="pestana-autorizaciones" tabindex="0">
    <h2 class="admin__titulo-seccion">Autorizaciones del apoderado</h2>

    @if (!Model.PuedeVerAutorizaciones)
    {
        <p class="admin__ayuda">Su rol no incluye la consulta de autorizaciones del apoderado.</p>
    }
    else if (Model.Autorizaciones.Count == 0)
    {
        <p class="admin__ayuda">Sin autorizaciones registradas.</p>
    }
    else
    {
        <div class="tabla-envoltura" tabindex="0">
            <table class="admin__tabla">
                <caption class="sr-only">Autorizaciones del apoderado, su estado, vigencia y revocación.</caption>
                <thead>
                    <tr>
                        <th scope="col">Autorización</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Firmada</th>
                        <th scope="col">Vigencia</th>
                        <th scope="col">Alcances</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var autorizacion in Model.Autorizaciones)
                    {
                        <tr>
                            <td>@autorizacion.Etiqueta</td>
                            <td>
                                @autorizacion.EstadoEtiqueta
                                @if (!string.IsNullOrWhiteSpace(autorizacion.MotivoRevocacion))
                                {
                                    <span class="admin__ayuda"> · @autorizacion.MotivoRevocacion</span>
                                }
                            </td>
                            <td>@(autorizacion.FechaFirma?.ToString("dd-MM-yyyy") ?? "—")</td>
                            <td>
                                @(autorizacion.VigenteDesde?.ToString("dd-MM-yyyy") ?? "—")
                                @if (autorizacion.VigenteHasta is DateOnly hasta)
                                {
                                    <span> → @hasta.ToString("dd-MM-yyyy")</span>
                                }
                            </td>
                            <td>
                                @(autorizacion.Alcances.Count == 0 ? "—" : string.Join(" · ", autorizacion.Alcances))
                            </td>
                            <td>
                                @if (Model.PuedeEditarAutorizaciones && autorizacion.Estado == "OTORGADA")
                                {
                                    <form method="post" asp-action="RevocarAutorizacion" asp-route-id="@Model.Id"
                                          data-ux-envio="Revocando la autorización…">
                                        <input type="hidden" name="autorizacionId" value="@autorizacion.Id" />
                                        <label class="sr-only" for="motivo-@autorizacion.Id">
                                            Motivo de la revocación de @autorizacion.Etiqueta
                                        </label>
                                        <input class="acceso__input" id="motivo-@autorizacion.Id" name="motivo"
                                               type="text" maxlength="500" required placeholder="Motivo de la revocación" />
                                        <button type="submit" class="admin__boton">Revocar</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="admin__ayuda">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</section>

<section class="admin__tarjeta" data-ux-grupo="documentos" role="tabpanel" id="panel-documentos"
         aria-labelledby="pestana-documentos" tabindex="0">
    <h2 class="admin__titulo-seccion">Documentos del expediente</h2>

    @if (Model.EstadoActual == "FICHA_GENERADA" && Model.MatriculaId is int fichaMatriculaId && puedeMatricula)
    {
        <form method="post" asp-action="RegistrarFirma" asp-route-id="@fichaMatriculaId"
              data-ux-envio="Registrando la firma…">
            <div class="acceso__campo">
                <label class="acceso__etiqueta" for="fecha-firma">Fecha de la firma del apoderado</label>
                <input class="acceso__input" id="fecha-firma" name="fecha" type="date"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="admin__boton">Registrar ficha firmada</button>
        </form>
        <p class="admin__ayuda">
            Marque este paso cuando Secretaría reciba la ficha firmada. El escaneo del documento
            firmado se incorpora en la Etapa II.
        </p>
    }

    @if (Model.PuedeConfirmar && Model.MatriculaId is int matriculaId && puedeMatricula)
    {
        <form method="post" asp-action="Confirmar" asp-route-id="@matriculaId"
              data-ux-envio="Confirmando la matrícula…">
            <button type="submit" class="admin__boton admin__boton--primario">
                Confirmar matrícula
            </button>
        </form>
        <p class="admin__ayuda">
            Confirme sólo cuando la ficha esté firmada y revisada según el procedimiento oficial.
        </p>
    }
    @if (Model.PuedeAnular && Model.MatriculaId is int anulableId && puedeMatricula)
    {
        <form method="post" asp-action="Anular" asp-route-id="@anulableId"
              data-ux-envio="Anulando la matrícula…">
            <div class="acceso__campo">
                <label class="acceso__etiqueta" for="motivo-anulacion">Motivo de la anulación</label>
                <textarea class="acceso__input" id="motivo-anulacion" name="motivo" rows="2" maxlength="500"
                          placeholder="Ej: matrícula duplicada, retiro del estudiante"></textarea>
            </div>
            <button type="submit" class="admin__boton"
                    data-ux-confirmar="¿Anular esta matrícula? La anulación exige motivo y queda registrada.">
                Anular matrícula
            </button>
        </form>
        <p class="admin__ayuda">
            La anulación libera el año: después puede iniciar una matrícula nueva. La confirmada no se anula por esta vía.
        </p>
    }
    @if (Model.ValidadaEn is DateTimeOffset validada)
    {
        <p class="admin__ayuda">
            Validada por Dirección@(Model.ValidadaPor is string validador ? $" ({validador})" : "")
            el @validada.ToLocalTime().ToString("dd-MM-yyyy HH:mm").
        </p>
    }
    else if (Model.PuedeValidar && Model.MatriculaId is int validableId)
    {
        <form method="post" asp-action="Validar" asp-route-id="@validableId"
              data-ux-envio="Validando la matrícula…">
            <button type="submit" class="admin__boton"
                    data-ux-confirmar="¿Validar esta matrícula? Queda registrada con su nombre y la fecha actual.">
                Validar matrícula
            </button>
        </form>
        <p class="admin__ayuda">
            La validación es el acto institucional de Dirección, distinto de confirmar. Solo sobre matrícula firmada o confirmada.
        </p>
    }
    @if (!Model.PuedeVerDocumentos)
    {
        <p class="admin__ayuda">Su rol no incluye la consulta de los documentos del expediente.</p>
    }
    else
    {
        <p class="admin__ayuda">
            Cada documento queda como recibido, pendiente o no aplica; ninguno bloquea la matrícula.
            Formatos PDF, JPG o PNG, hasta 15 MB.
        </p>

        @if (Model.Documentos.Count == 0)
        {
            <p class="admin__ayuda">La matrícula del año no tiene requisitos documentales registrados.</p>
        }
        else
        {
            <div class="tabla-envoltura" tabindex="0">
                <table class="admin__tabla expediente__tabla">
                    <caption class="sr-only">Documentos requeridos para la matrícula del año, su estado y archivo.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Documento</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Archivo</th>
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var documento in Model.Documentos)
                        {
                            <tr>
                                <td data-etiqueta="Documento"><strong>@documento.Etiqueta</strong></td>
                                <td data-etiqueta="Estado">
                                    <span class="expediente__estado @(documento.Estado == "RECIBIDO" ? "expediente__estado--recibido" : documento.Estado == "NO_APLICA" ? "expediente__estado--no-aplica" : "expediente__estado--pendiente")">
                                    @(documento.Estado switch
                                    {
                                        "RECIBIDO" => "Recibido",
                                        "NO_APLICA" => "No aplica",
                                        _ => "Pendiente",
                                    })
                                    </span>
                                </td>
                                <td data-etiqueta="Archivo">
                                    @if (documento.DocumentoId is int archivoId)
                                    {
                                        <a asp-action="DescargarDocumento" asp-route-id="@Model.Id"
                                           asp-route-documentoId="@archivoId">@(documento.NombreArchivo ?? "Descargar")</a>
                                        @if (documento.SubidoEn is DateTimeOffset subido)
                                        {
                                            <span class="admin__ayuda"> · @subido.ToLocalTime().ToString("dd-MM-yyyy")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="admin__ayuda">Sin archivo adjunto</span>
                                    }
                                </td>
                                <td data-etiqueta="Acciones">
                                    @if (Model.PuedeSubirDocumentos)
                                    {
                                        <div class="admin__acciones">
                                            <form method="post" asp-action="SubirDocumento" asp-route-id="@Model.Id"
                                                  enctype="multipart/form-data">
                                                <input type="hidden" name="requisitoId" value="@documento.RequisitoId" />
                                                <label class="sr-only" for="archivo-@documento.RequisitoId">
                                                    Archivo para @documento.Etiqueta
                                                </label>
                                                <input class="acceso__input" id="archivo-@documento.RequisitoId" name="archivo"
                                                       type="file" accept=".pdf,.jpg,.jpeg,.png" required />
                                                <button type="submit" class="admin__boton">
                                                    @(documento.DocumentoId is null ? "Subir" : "Reemplazar")
                                                </button>
                                            </form>
                                            @if (documento.Estado != "NO_APLICA")
                                            {
                                                <form method="post" asp-action="MarcarDocumento" asp-route-id="@Model.Id">
                                                    <input type="hidden" name="requisitoId" value="@documento.RequisitoId" />
                                                    <input type="hidden" name="estado" value="NO_APLICA" />
                                                    <button type="submit" class="admin__boton">No aplica</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.PuedeSubirDocumentos && Model.MatriculaId is int matriculaFirmada
             && Model.EstadoActual is "FICHA_GENERADA" or "FIRMADA")
        {
            <div class="expediente__escaneo">
            <h3 class="admin__titulo-seccion">Escaneo de la ficha firmada</h3>
            <p class="admin__ayuda">
                Adjunte el PDF o la foto de la ficha firmada por el apoderado. Queda asociada a la matrícula y
                reemplaza al escaneo anterior sin borrarlo.
            </p>
            @if (Model.FichaFirmadaDocumentoId is int escaneoId)
            {
                <p class="admin__ayuda">
                    Escaneo adjunto:
                    <a asp-action="DescargarDocumento" asp-route-id="@Model.Id"
                       asp-route-documentoId="@escaneoId">@(Model.FichaFirmadaNombre ?? "Descargar")</a>
                    @if (Model.FichaFirmadaSubidaEn is DateTimeOffset escaneoEn)
                    {
                        <span> · @escaneoEn.ToLocalTime().ToString("dd-MM-yyyy")</span>
                    }
                </p>
            }
            <form method="post" asp-action="SubirFichaFirmada" asp-route-id="@Model.Id"
                  enctype="multipart/form-data">
                <input type="hidden" name="matriculaId" value="@matriculaFirmada" />
                <div class="acceso__campo">
                    <label class="acceso__etiqueta" for="ficha-firmada">Archivo de la ficha firmada</label>
                    <input class="acceso__input" id="ficha-firmada" name="archivo" type="file"
                           accept=".pdf,.jpg,.jpeg,.png" required />
                </div>
                <button type="submit" class="admin__boton">Subir ficha firmada</button>
            </form>
            </div>
        }
    }
</section>

<div class="perfil__grid" data-ux-grupo="general" role="tabpanel" id="panel-general-datos"
     aria-labelledby="pestana-general" tabindex="0">
    <section class="admin__tarjeta">
        <h2 class="admin__titulo-seccion">Datos personales</h2>

        <div class="perfil__dato"><span>RUN</span><strong>@Model.Rut</strong></div>
        <div class="perfil__dato">
            <span>Fecha de nacimiento</span>
            <strong>@(Model.FechaNacimiento?.ToString("dd-MM-yyyy") ?? "—")</strong>
        </div>
        <div class="perfil__dato"><span>Edad</span><strong>@(Model.Edad?.ToString() ?? "—")</strong></div>
        <div class="perfil__dato"><span>Nacionalidad</span><strong>@(Model.Nacionalidad ?? "—")</strong></div>
        <div class="perfil__dato"><span>Domicilio</span><strong>@(Model.Domicilio ?? "—")</strong></div>
        <div class="perfil__dato"><span>Comuna</span><strong>@(Model.Comuna ?? "—")</strong></div>
        <div class="perfil__dato">
            <span>Sale solo al finalizar la jornada</span>
            <strong>@(Model.SaleSolo is bool saleSolo ? (saleSolo ? "Sí" : "No") : "—")</strong>
        </div>
    </section>

    <section class="admin__tarjeta">
        <h2 class="admin__titulo-seccion">Matrículas</h2>

        @if (Model.Matriculas.Count == 0)
        {
            <p class="admin__ayuda">Sin matrículas registradas.</p>
        }
        else
        {
            <div class="tabla-envoltura" tabindex="0">
                <table class="admin__tabla">
                    <caption class="sr-only">Matrículas del estudiante, por año y estado.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Año</th>
                            <th scope="col">Curso</th>
                            <th scope="col">Matrícula</th>
                            <th scope="col">Estado</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var matricula in Model.Matriculas)
                    {
                        <tr>
                            <td>@matricula.Anio</td>
                            <td>@(matricula.Curso ?? "—")</td>
                            <td>@(matricula.Tipo == "RENOVACION" ? "Renovación" : "Nueva")</td>
                            <td>@matricula.Estado</td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
    </section>
</div>

<section class="admin__tarjeta" data-ux-grupo="general" role="tabpanel" id="panel-general-apoderados"
         aria-labelledby="pestana-general" tabindex="0">
    <h2 class="admin__titulo-seccion">Apoderados</h2>

    @if (!Model.PuedeVerFamilia)
    {
        <p class="admin__ayuda">Su rol no incluye la consulta de los datos familiares.</p>
    }
    else if (Model.Apoderados.Count == 0)
    {
        <p class="admin__ayuda">Sin apoderados registrados.</p>
    }
    else
    {
        <div class="tabla-envoltura" tabindex="0">
                <table class="admin__tabla">
                    <caption class="sr-only">Apoderados del estudiante, con RUN, vínculo y contacto.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">RUN</th>
                            <th scope="col">Vínculo</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Correo</th>
                        </tr>
                    </thead>
            <tbody>
                @foreach (var apoderado in Model.Apoderados)
                {
                    <tr>
                        <td>
                            @apoderado.Nombre
                            @if (apoderado.TieneRestriccion)
                            {
                                <span class="admin__chip admin__chip--alerta">Restricción</span>
                            }
                        </td>
                        <td>@apoderado.Rut</td>
                        <td>@apoderado.Vinculo</td>
                        <td>@(apoderado.Telefono ?? "—")</td>
                        <td>@(apoderado.Correo ?? "—")</td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
    }
    @if (Model.PuedeVerFamilia && Model.ApoderadosAnteriores.Count > 0)
    {
        <h3 class="admin__titulo-seccion">Apoderados anteriores</h3>
        <div class="tabla-envoltura" tabindex="0">
            <table class="admin__tabla">
                <caption class="sr-only">Vínculos familiares ya cerrados, con su fecha de término.</caption>
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">RUN</th>
                        <th scope="col">Vínculo</th>
                        <th scope="col">Vigente hasta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var apoderado in Model.ApoderadosAnteriores)
                    {
                        <tr>
                            <td>@apoderado.Nombre</td>
                            <td>@apoderado.Rut</td>
                            <td>@apoderado.Vinculo</td>
                            <td>@(apoderado.Hasta?.ToString("dd-MM-yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="perfil__grid" data-ux-grupo="general" role="tabpanel" id="panel-general-contactos"
     aria-labelledby="pestana-general" tabindex="0">
    <section class="admin__tarjeta">
        <h2 class="admin__titulo-seccion">Contactos de emergencia</h2>

        @if (!Model.PuedeVerFamilia)
        {
            <p class="admin__ayuda">Su rol no incluye la consulta de los datos familiares.</p>
        }
        else if (Model.Contactos.Count == 0)
        {
            <p class="admin__ayuda">Sin contactos registrados.</p>
        }
        else
        {
            <div class="tabla-envoltura" tabindex="0">
                <table class="admin__tabla">
                    <caption class="sr-only">Contactos de emergencia del estudiante.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Vínculo</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var contacto in Model.Contactos)
                    {
                        <tr>
                            <td>@contacto.Nombre</td>
                            <td>@contacto.Telefono</td>
                            <td>@contacto.Vinculo</td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
    </section>

    <section class="admin__tarjeta">
        <h2 class="admin__titulo-seccion">Personas autorizadas a retirar</h2>

        @if (!Model.PuedeVerRetiro)
        {
            <p class="admin__ayuda">Su rol no incluye la consulta de las personas autorizadas a retirar.</p>
        }
        else if (Model.Retiros.Count == 0)
        {
            <p class="admin__ayuda">Sin personas autorizadas registradas.</p>
        }
        else
        {
            <div class="tabla-envoltura" tabindex="0">
                <table class="admin__tabla">
                    <caption class="sr-only">Personas autorizadas a retirar al estudiante.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">RUN</th>
                            <th scope="col">Vínculo</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var retiro in Model.Retiros)
                    {
                        <tr>
                            <td>@retiro.Nombre</td>
                            <td>@retiro.Rut</td>
                            <td>@retiro.Vinculo</td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
    </section>
</div>

<section class="admin__tarjeta" data-ux-grupo="salud" role="tabpanel" id="panel-salud"
         aria-labelledby="pestana-salud" tabindex="0">
    <h2 class="admin__titulo-seccion">Salud y restricciones</h2>

    @if (!Model.PuedeVerSalud && !Model.PuedeVerFamilia)
    {
        <p class="admin__ayuda">Su rol no incluye la consulta de datos de salud ni de restricciones familiares.</p>
    }

    @if (Model.PuedeVerSalud)
    {
    <div class="perfil__dato">
        <span>¿Tiene situación médica declarada?</span>
        <strong>@(Model.TieneSituacionMedica is bool tiene ? (tiene ? "Sí" : "No") : "—")</strong>
    </div>
    <div class="perfil__dato">
        <span>Necesidades de atención</span>
        <strong>@(Model.NecesidadesAtencion ?? "—")</strong>
    </div>
    <div class="perfil__dato">
        <span>Alergias</span>
        <strong>@(Model.Alergias ?? "Sin alergias declaradas")</strong>
    </div>
    <div class="perfil__dato">
        <span>Contacto ante urgencia sanitaria</span>
        <strong>
            @(Model.ContactoSanitarioNombre ?? "—")
            @if (!string.IsNullOrWhiteSpace(Model.ContactoSanitarioTelefono))
            {
                <span> · @Model.ContactoSanitarioTelefono</span>
            }
        </strong>
    </div>
    }

    @if (Model.PuedeVerSalud && Model.Situaciones.Count > 0)
    {
        <div class="tabla-envoltura" tabindex="0">
            <table class="admin__tabla">
                <caption class="sr-only">Situaciones médicas declaradas del estudiante.</caption>
                <thead>
                    <tr>
                        <th scope="col">Tipo</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">En tratamiento</th>
                    </tr>
                </thead>
            <tbody>
                @foreach (var situacion in Model.Situaciones)
                {
                    <tr>
                        <td>@situacion.Tipo</td>
                        <td>@situacion.Descripcion</td>
                        <td>@(situacion.EnTratamiento is bool enTratamiento ? (enTratamiento ? "Sí" : "No") : "—")</td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
    }

    @if (Model.PuedeVerFamilia && Model.Restricciones.Count > 0)
    {
        <div class="perfil__aviso">
            <strong>Restricciones vigentes</strong>
            <ul class="perfil__restricciones">
                @foreach (var restriccion in Model.Restricciones)
                {
                    <li>@restriccion</li>
                }
            </ul>
        </div>
    }
</section>

<section class="admin__tarjeta" data-ux-grupo="pie" role="tabpanel" id="panel-pie"
         aria-labelledby="pestana-pie" tabindex="0">
    <h2 class="admin__titulo-seccion">PIE y apoyos</h2>

    @if (Model.PuedeVerPie)
    {
        <div class="perfil__dato">
            <span>Participa del PIE</span>
            <strong>
                @(Model.PieParticipa switch
                {
                    "SI" => "Sí",
                    "NO" => "No",
                    _ => "Pendiente",
                })
            </strong>
        </div>
        <div class="perfil__dato">
            <span>Cuenta con diagnóstico</span>
            <strong>@(Model.PieDiagnostico is bool tiene ? (tiene ? "Sí" : "No") : "—")</strong>
        </div>
        <div class="perfil__dato">
            <span>Apoyos informados</span>
            <strong>@(Model.PieApoyos ?? "—")</strong>
        </div>
    }
    else
    {
        <p class="admin__ayuda">Su rol no incluye la consulta de los apoyos del PIE.</p>
    }
</section>
</div>
