@model MarcelaPaz.Web.Models.FuncionarioEditarForm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar funcionario";
    var roles = (List<MarcelaPaz.Domain.Entidades.Rol>)(ViewData["Roles"] ?? new List<MarcelaPaz.Domain.Entidades.Rol>());
    var correo = ViewData["CorreoFuncionario"] as string ?? "";
}

<div class="admin__tarjeta">
    <h1 class="admin__titulo-seccion">Editar funcionario</h1>
    <p class="admin__ayuda">
        El correo es la identidad de la cuenta y no se cambia aquí. Para ajustar el acceso,
        marque los roles vigentes; los que se desmarquen dejan de estar vigentes de inmediato.
    </p>

    <form asp-action="Editar" asp-route-id="@ViewData["FuncionarioId"]" method="post">
        <partial name="_ResumenValidacion" />

        <div class="acceso__campo">
            <label class="acceso__etiqueta">Correo</label>
            <input class="acceso__input" value="@correo" readonly="readonly" aria-readonly="true" />
        </div>

        <div class="acceso__campo">
            <label asp-for="Nombre" class="acceso__etiqueta"></label>
            <input asp-for="Nombre" class="acceso__input" autocomplete="off" />
            <span asp-validation-for="Nombre" class="acceso__error"></span>
        </div>

        <fieldset class="acceso__campo admin__fieldset">
            <legend class="acceso__etiqueta">Roles</legend>
            <div class="admin__lista-roles">
                @foreach (var rol in roles)
                {
                    <label class="admin__check">
                        <input type="checkbox" name="Roles" value="@rol.Codigo"
                               checked="@(Model.Roles.Contains(rol.Codigo))" />
                        <span>@rol.Nombre</span>
                    </label>
                }
            </div>
        </fieldset>

        <div class="admin__acciones">
            <button type="submit" class="admin__boton admin__boton--primario">Guardar cambios</button>
            <a class="admin__boton" asp-action="Index">Volver</a>
        </div>
    </form>
</div>
