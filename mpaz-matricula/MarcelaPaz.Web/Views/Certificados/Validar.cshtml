@model MarcelaPaz.Web.Models.ValidacionCertificado
@{
    // Página pública sin sesión: la abre quien recibe el papel, casi siempre
    // escaneando el QR desde el teléfono. Todo cabe en una pantalla.
    Layout = null;
    ViewData["Title"] = "Validar certificado de alumno regular";

    var huboConsulta = !string.IsNullOrWhiteSpace(Context.Request.Query["codigo"]);
    var emitido = Model.EmitidoEn is DateTimeOffset momento
        ? momento.ToLocalTime().ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CL"))
        : null;

    var vence = Model.VigenteHasta is DateTimeOffset limite
        ? limite.ToLocalTime().ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CL"))
        : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] · Portal Marcela Paz</title>
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/validar.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/logo-mpaz-simplificado.ico" />
</head>
<body class="validacion">

    <header class="validacion__cabecera">
        <div class="validacion__marca">
            <img src="~/images/logo-mpaz.svg"
                 alt="Logo Escuela Escritora Marcela Paz"
                 class="validacion__logo"
                 width="32" />
            <div>
                <p class="validacion__portal">Portal Marcela Paz</p>
                <p class="validacion__colegio">Escuela Básica &laquo;Escritora Marcela Paz&raquo;</p>
            </div>
        </div>
    </header>

    <main class="validacion__contenido">
        <p class="validacion__sobre">Verificación pública de documentos</p>
        <h1 class="validacion__titulo">Certificado de alumno regular</h1>
        <p class="validacion__bajada">
            Compruebe que un certificado impreso fue emitido por el establecimiento y sigue vigente.
        </p>

        @if (Model.Valido)
        {
            <section class="resultado resultado--valido" aria-labelledby="estado-certificado">
                <div class="resultado__estado">
                    <div class="resultado__chip">
                        <span class="resultado__icono" aria-hidden="true">&#10003;</span>
                        <h2 class="resultado__titulo" id="estado-certificado">Documento válido</h2>
                    </div>
                    <p class="resultado__texto">Emitido por el establecimiento y vigente.</p>
                </div>

                <dl class="resultado__datos">
                    <div class="resultado__dato">
                        <dt>Folio</dt>
                        <dd>@Model.Folio</dd>
                    </div>
                    <div class="resultado__dato">
                        <dt>Año académico</dt>
                        <dd>@Model.Anio</dd>
                    </div>
                    <div class="resultado__dato">
                        <dt>Curso</dt>
                        <dd>@Model.Curso</dd>
                    </div>
                    <div class="resultado__dato">
                        <dt>Emitido</dt>
                        <dd>@emitido</dd>
                    </div>
                    <div class="resultado__dato">
                        <dt>Vigente hasta</dt>
                        <dd>@vence</dd>
                    </div>
                    <div class="resultado__dato resultado__dato--ancho">
                        <dt>Estudiante</dt>
                        <dd>@Model.AlumnoNombre</dd>
                    </div>
                </dl>
            </section>

            <p class="validacion__otro">
                ¿Tiene otro certificado? <a asp-controller="Certificados" asp-action="Validar">Validar otro documento</a>
            </p>
        }
        else if (Model.Vencido)
        {
            <section class="resultado resultado--invalido" aria-labelledby="estado-certificado" role="status">
                <div class="resultado__estado">
                    <div class="resultado__chip">
                        <span class="resultado__icono" aria-hidden="true">!</span>
                        <h2 class="resultado__titulo" id="estado-certificado">Documento vencido</h2>
                    </div>
                    <p class="resultado__texto">
                        El certificado es auténtico, pero su vigencia terminó el @vence. Solicite uno nuevo al establecimiento.
                    </p>
                </div>

                <dl class="resultado__datos">
                    <div class="resultado__dato">
                        <dt>Folio</dt>
                        <dd>@Model.Folio</dd>
                    </div>
                    <div class="resultado__dato">
                        <dt>Emitido</dt>
                        <dd>@emitido</dd>
                    </div>
                    <div class="resultado__dato">
                        <dt>Venció</dt>
                        <dd>@vence</dd>
                    </div>
                </dl>
            </section>
        }
        else
        {
            @if (huboConsulta)
            {
                <section class="resultado resultado--invalido" aria-labelledby="estado-certificado" role="status">
                    <div class="resultado__estado">
                        <div class="resultado__chip">
                            <span class="resultado__icono" aria-hidden="true">!</span>
                            <h2 class="resultado__titulo" id="estado-certificado">Documento no válido</h2>
                        </div>
                        <p class="resultado__texto">
                            El folio y el código no corresponden a un certificado vigente.
                            Revise que estén bien escritos.
                        </p>
                    </div>
                </section>
            }

            <form class="validacion__form" method="get" asp-controller="Certificados" asp-action="Validar">
                <div class="validacion__campo">
                    <label class="validacion__etiqueta" for="folio">Folio</label>
                    <input class="validacion__input"
                           id="folio"
                           name="folio"
                           type="text"
                           value="@Model.Folio"
                           placeholder="CAR-2027-000010"
                           autocomplete="off"
                           spellcheck="false"
                           required />
                </div>

                <div class="validacion__campo">
                    <label class="validacion__etiqueta" for="codigo">Código de verificación</label>
                    <input class="validacion__input"
                           id="codigo"
                           name="codigo"
                           type="text"
                           placeholder="XXXX-XXXX-XXXX"
                           autocomplete="off"
                           autocapitalize="characters"
                           spellcheck="false"
                           required />
                </div>

                <button class="validacion__boton" type="submit">Validar</button>
            </form>
        }
    </main>

    <footer class="validacion__pie">
        <p>Servicio Local de Educación Pública Del Pino · La consulta sólo comprueba el documento.</p>
    </footer>

</body>
</html>
