@model MarcelaPaz.Web.Models.FichaForm
@{
    Layout = "_WizardLayout";
}
<h1 class="wizard__titulo-paso">Paso 1 · Datos del apoderado</h1>
<p class="wizard__ayuda">
    Primero el curso al que postula, luego la identificación y el domicilio.
    Los campos obligatorios y sus textos se definirán con el colegio.
</p>

<form asp-controller="Ficha" asp-action="Guardar" asp-route-id="1" method="post">

    <details class="wizard__desplegable" open>
        <summary class="wizard__desplegable-resumen">
            Curso y año
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Curso_Nivel" class="acceso__etiqueta">Curso</label>
                    <select asp-for="Curso_Nivel" class="acceso__input">
                        <option value="">— Seleccione —</option>
                        <option>NT1</option>
                        <option>NT2</option>
                        <option>1º básico</option>
                        <option>2º básico</option>
                        <option>3º básico</option>
                        <option>4º básico</option>
                        <option>5º básico</option>
                        <option>6º básico</option>
                        <option>7º básico</option>
                        <option>8º básico</option>
                    </select>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Curso_Letra" class="acceso__etiqueta">Letra</label>
                    <select asp-for="Curso_Letra" class="acceso__input">
                        <option value="">— Seleccione —</option>
                        <option>A</option>
                        <option>B</option>
                        <option>C</option>
                        <option>D</option>
                    </select>
                </div>
                <div class="acceso__campo">
                    <label asp-for="Curso_Anio" class="acceso__etiqueta">Año escolar</label>
                    <input asp-for="Curso_Anio" class="acceso__input" value="2027" readonly />
                </div>
            </div>
        </div>
    </details>

    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Identificación del apoderado
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Nombres" class="acceso__etiqueta">Nombres</label>
                    <input asp-for="Nombres" class="acceso__input" placeholder="Ej: María" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Apellido_Paterno" class="acceso__etiqueta">Apellido Paterno</label>
                    <input asp-for="Apellido_Paterno" class="acceso__input" placeholder="Ej: Pérez Soto" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Apellido_Materno" class="acceso__etiqueta">Apellido Materno</label>
                    <input asp-for="Apellido_Materno" class="acceso__input" placeholder="Ej: Pérez Soto" autocomplete="off" />
                </div>
            </div>
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Cedula_Identidad" class="acceso__etiqueta">Cédula de identidad</label>
                    <input asp-for="Cedula_Identidad" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Fecha_Nacimiento" class="acceso__etiqueta">Fecha nacimiento</label>
                    <input asp-for="Fecha_Nacimiento" type="date" class="acceso__input" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Nacionalidad" class="acceso__etiqueta">Nacionalidad</label>
                    <input asp-for="Nacionalidad" class="acceso__input" placeholder="Ej: Chilena" autocomplete="off" />
                </div>
            </div>
        </div>
    </details>

    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Domicilio
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="acceso__campo">
                <label asp-for="Domicilio" class="acceso__etiqueta">Domicilio (calle – nº – villa o población)</label>
                <input asp-for="Domicilio" class="acceso__input" placeholder="Ej: Los Aromos 1234, Villa Los Aromos" autocomplete="off" />
            </div>
            <div class="acceso__campo">
                <label asp-for="Comuna" class="acceso__etiqueta">Comuna</label>
                <input asp-for="Comuna" class="acceso__input" placeholder="Ej: San Bernardo" autocomplete="off" />
            </div>
        </div>
    </details>

    <div class="wizard__botones">
        <button type="submit" class="acceso__boton wizard__guardar">Guardar y continuar</button>
    </div>
</form>
