@model MarcelaPaz.Web.Models.FichaForm
@{
    Layout = "_WizardLayout";
}
<h1 class="wizard__titulo-paso">Paso 5 · Retiro del estudiante</h1>
<p class="wizard__ayuda">
    Salida al finalizar la jornada y personas autorizadas a retirar, en bloques desplegables.
    Por ahora nada es obligatorio.
</p>

<form asp-controller="Ficha" asp-action="Guardar" asp-route-id="5" method="post">

    <fieldset class="wizard__restriccion">
        <legend class="acceso__etiqueta">Salida al finalizar la jornada (SI/NO)</legend>
        <p class="wizard__restriccion-pregunta">
            Al finalizar la jornada de clases, ¿el estudiante está autorizado para salir solo de la escuela?
        </p>
        <div class="wizard__radios">
            <label class="acceso__radio">
                <input asp-for="SalidaSolo" type="radio" value="Si" />
                <span>Si</span>
            </label>
            <label class="acceso__radio">
                <input asp-for="SalidaSolo" type="radio" value="No" />
                <span>No</span>
            </label>
        </div>
    </fieldset>

    <p class="wizard__restriccion-pregunta">Durante la jornada, el estudiante solo puede ser retirado por:</p>

    <details class="wizard__desplegable" open>
        <summary class="wizard__desplegable-resumen">
            Registro 01 · Persona autorizada a retirar
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Retiro1_Rut" class="acceso__etiqueta">RUT</label>
                    <input asp-for="Retiro1_Rut" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Retiro1_Vinculo" class="acceso__etiqueta">Vínculo con el estudiante</label>
                    <input asp-for="Retiro1_Vinculo" class="acceso__input" placeholder="Ej: madre" autocomplete="off" />
                </div>
            </div>
        </div>
    </details>

    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Registro 02 · Persona autorizada a retirar
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Retiro2_Rut" class="acceso__etiqueta">RUT</label>
                    <input asp-for="Retiro2_Rut" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Retiro2_Vinculo" class="acceso__etiqueta">Vínculo con el estudiante</label>
                    <input asp-for="Retiro2_Vinculo" class="acceso__input" autocomplete="off" />
                </div>
            </div>
        </div>
    </details>

    <details class="wizard__desplegable">
        <summary class="wizard__desplegable-resumen">
            Registro 03 · Persona autorizada a retirar
            <span class="wizard__desplegable-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="wizard__desplegable-cuerpo">
            <div class="wizard__fila">
                <div class="acceso__campo">
                    <label asp-for="Retiro3_Rut" class="acceso__etiqueta">RUT</label>
                    <input asp-for="Retiro3_Rut" class="acceso__input" placeholder="Ej: 12.345.678-9" autocomplete="off" />
                </div>
                <div class="acceso__campo">
                    <label asp-for="Retiro3_Vinculo" class="acceso__etiqueta">Vínculo con el estudiante</label>
                    <input asp-for="Retiro3_Vinculo" class="acceso__input" autocomplete="off" />
                </div>
            </div>
        </div>
    </details>

    <div class="wizard__botones">
        <a class="acceso__boton-secundario" asp-controller="Ficha" asp-action="Paso" asp-route-id="4">Volver</a>
        <button type="submit" class="acceso__boton wizard__guardar">Guardar y continuar</button>
    </div>
</form>
