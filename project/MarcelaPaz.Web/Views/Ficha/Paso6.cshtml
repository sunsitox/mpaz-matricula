@{
    Layout = "_WizardLayout";
}
<h1 class="wizard__titulo-paso">Paso 6 · Datos médicos</h1>
<p class="wizard__ayuda">
    Paso pendiente de construcción: la pregunta de situación médica, el detalle
    de situaciones (registros 01 a 03), el uso de baños y el uso de paracetamol
    se armarán con el colegio.
</p>

<form asp-controller="Ficha" asp-action="Guardar" asp-route-id="6" method="post">
    <div class="acceso__aviso">
        Contenido de este paso sin construir todavía. Puede avanzar para revisar la estructura completa.
    </div>

    <div class="wizard__botones">
        <a class="acceso__boton-secundario" asp-controller="Ficha" asp-action="Paso" asp-route-id="5">Volver</a>
        <button type="submit" class="acceso__boton wizard__guardar">Guardar y continuar</button>
    </div>
</form>
