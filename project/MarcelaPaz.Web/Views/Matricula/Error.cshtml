@{
    Layout = null;
    ViewData["Title"] = "Error";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - Escuela Básica Escritora Marcela Paz</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="error">
    <main class="error__card">
        <!-- Logo oficial del colegio: emblema circular con borde dorado -->
        <img src="~/images/logo-mpaz.svg"
             alt="Logo Escuela Escritora Marcela Paz"
             class="acceso__logo-img"
             width="48" />
        <h1>Ocurrió un problema</h1>
        <p>No pudimos completar la operación. Intente nuevamente.</p>
        <p>Si el problema continúa, pida ayuda en la secretaría del colegio.</p>
        <a class="acceso__enlace" asp-controller="Matricula" asp-action="Acceso">Volver al inicio</a>
    </main>
</body>
</html>
